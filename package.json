{
  "name": "smm-pro",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,gray \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server --",
    "clean-data": "npm run clean-data --workspace server --",
    "create-admin": "npm run create-admin --workspace server --",
    "backup": "npm run backup --workspace server --",
    "restore": "npm run restore --workspace server --",
    "setup:free": "npm run setup:free --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}