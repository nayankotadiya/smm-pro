# ---------- Core ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173          # frontend origin (used for CORS + links)
PUBLIC_APPROVAL_URL=http://localhost:5173/approval
# Refresh-token cookie. Keep 'lax' when the app and API share a site (app.example.com + api.example.com, or /api proxied by the frontend host).
# 'none' is only for app and API on unrelated domains and is blocked by Safari — avoid it.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/smmpro
DB_MAX_POOL_SIZE=50                     # MongoDB connection pool max size (default 50)
DB_MIN_POOL_SIZE=5                      # MongoDB connection pool min idle connections (default 5)
BACKUP_RETENTION_COUNT=14               # Daily backups to keep before rotating (default 14)
JWT_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random
APPROVAL_TOKEN_TTL_HOURS=168
APP_TIMEZONE=Asia/Kolkata

# ---------- Google Drive ----------
# Preferred: service account with access to a company Shared Drive
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=     # base64 of the service-account key JSON
GOOGLE_SHARED_DRIVE_ID=                 # Shared Drive ID (service account must be Content Manager)
# Alternative: OAuth user refresh token (used only if no service account is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_NAME=SMM PRO
MAX_UPLOAD_MB=4096

# ---------- AiSensy ----------
AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_CAMPAIGN_NAME=
AISENSY_TEMPLATE_NAME=
AISENSY_PHONE_NUMBER_ID=
# Template variables sent, in order: {{1}} contact name, {{2}} content title, {{3}} version, {{4}} review link
# Set to true only if your template has a dynamic URL button whose base is PUBLIC_APPROVAL_URL/ (the token is sent as its suffix)
AISENSY_USE_URL_BUTTON=false
AISENSY_WEBHOOK_SECRET=                 # shared secret appended to the webhook URL (?secret=...)

# ---------- Redis (optional; in-process scheduler is used if empty) ----------
REDIS_URL=

# ---------- Web Push (generate with: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- Email ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SMM PRO <no-reply@example.com>"
