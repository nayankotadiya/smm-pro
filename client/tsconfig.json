{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "isolatedModules": true, "allowImportingTsExtensions": false, "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": ["vite/client"]
  },
  "include": ["src"]
}
